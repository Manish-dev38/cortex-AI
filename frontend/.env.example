# Copy to .env. Never commit real values.
# Public origin of the gateway (the only backend the browser talks to).
VITE_SERVER_URL=http://localhost:5000

# Firebase Web API key (public by design; restrict it by domain in the console).
VITE_FIREBASE_API_KEY=

# Razorpay public key id (safe to expose; never put the secret here).
VITE_RAZOR_KEY_ID=
