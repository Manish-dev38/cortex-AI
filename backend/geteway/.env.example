# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=5000
# Bind to loopback by default. Only bind 0.0.0.0 behind a reverse proxy.
HOST=127.0.0.1

# Internal service base URLs (gateway strips the /api/* prefix before proxying).
AUTH_SERVICE=http://127.0.0.1:7001
CHAT_SERVICE=http://127.0.0.1:8002
AGENT_SERVICE=http://127.0.0.1:3001
BILLING_SERVICE=http://127.0.0.1:8004

# Comma-separated browser origins allowed in production.
FRONTEND_URL=http://localhost:5173

REDIS_URL=redis://127.0.0.1:6379

# Shared secret proving gateway identity to every internal service.
# Generate with: node -e "console.log(require('crypto').randomUUID())"
INTERNAL_SERVICE_TOKEN=
