# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
REDIS_URL=redis://127.0.0.1:6379

# Internal services the agent calls.
CHAT_SERVICE=http://127.0.0.1:8002
AUTH_SERVICE=http://127.0.0.1:7001

# Shared secret proving gateway identity and signing internal calls.
INTERNAL_SERVICE_TOKEN=

# LLM providers.
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Optional OpenAI-compatible embeddings endpoint (not required by default).
OPENAI_API_KEY=

# Object storage for generated PDFs/PPTs/images.
AWS_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=

# Qdrant vector store (per-upload PDF collections are deleted after use).
QDRANT_URL=
QDRANT_API_KEY=

# Optional comma-separated DNS override; leave blank to use system DNS.
CUSTOM_DNS_SERVERS=
