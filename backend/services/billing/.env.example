# Copy to .env and fill via secret manager. Never commit real values.
PORT=8004
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
AUTH_SERVICE=http://localhost:7001
RAZOR_KEY_ID=rzp_test_xxx
RAZOR_KEY_SECRET=xxx
# Dedicated webhook secret (falls back to RAZOR_KEY_SECRET when unset).
RAZOR_WEBHOOK_SECRET=xxx
# Shared token sent to AUTH_SERVICE as x-service-token (optional but recommended).
BILLING_INTERNAL_TOKEN=xxx
# Outbound credit-call timeout in ms (1000-30000).
AUTH_SERVICE_TIMEOUT_MS=8000
# Comma-separated DNS override for restricted networks (optional, else system DNS).
CUSTOM_DNS_SERVERS=
# GST/inclusive tax rate, e.g. 0.18 for 18%.
TAX_RATE_GST=0.18
