# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=7001
HOST=127.0.0.1

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
REDIS_URL=redis://127.0.0.1:6379

# Shared secret proving gateway/billing/agent identity. Must match every
# service and the gateway.
INTERNAL_SERVICE_TOKEN=

# Session cookie behaviour.
SESSION_TTL_DAYS=7
# Force Secure cookies outside production (e.g. when testing over HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional; leave blank for host-only cookies.
COOKIE_DOMAIN=

# Optional comma-separated DNS override; leave blank to use system DNS.
CUSTOM_DNS_SERVERS=
