# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=8002
HOST=127.0.0.1

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Shared secret proving gateway/agent identity. Must match every service.
INTERNAL_SERVICE_TOKEN=

# Optional comma-separated DNS override; leave blank to use system DNS.
CUSTOM_DNS_SERVERS=
